[mysqld]
# Logs útiles para tests y profiling
slow_query_log=ON
long_query_time=0.2
log_output=FILE
slow_query_log_file=/var/lib/mysql/slow.log

# Performance Schema suele estar ON en MySQL 8, lo explicitamos.
performance_schema=ON

# El schema oficial incluye triggers; en test no queremos depender de SUPER
# ni de un dump alternativo solo para el runner.
log_bin_trust_function_creators=1
