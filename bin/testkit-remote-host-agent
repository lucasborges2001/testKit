#!/usr/bin/env bash
set -euo pipefail

TESTKIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
RUNNER="$TESTKIT_ROOT/runners/runRemoteHostAgentCompat.php"

if [ ! -f "$RUNNER" ]; then
  echo "ERROR: missing TestKit remote host agent compatibility runner: $RUNNER" >&2
  exit 2
fi

exec php "$RUNNER" "$@"
