#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BASE="${HERE}/compose.yaml"
MYSQL="${HERE}/compose.mysql.yaml"
REDIS="${HERE}/compose.redis.yaml"
PG="${HERE}/compose.pg.yaml"

PROJECT_ROOT="${TESTKIT_PROJECT_ROOT:-}"
if [[ -z "${PROJECT_ROOT}" ]]; then
  PROJECT_ROOT="$(cd "${HERE}/.." && pwd)"
fi
PROJECT_ROOT="$(cd "${PROJECT_ROOT}" && pwd)"

TESTKIT_ROOT_HOST="${TESTKIT_ROOT:-$HERE}"
TESTKIT_ROOT_HOST="$(cd "${TESTKIT_ROOT_HOST}" && pwd)"
TESTKIT_HOST_UID="${TESTKIT_HOST_UID:-$(id -u)}"
TESTKIT_HOST_GID="${TESTKIT_HOST_GID:-$(id -g)}"

DOCTOR_DOCKER_MODE="${TESTKIT_DOCTOR_DOCKER_MODE:-auto}"
TESTKIT_COMPOSE_VERBOSE="${TESTKIT_COMPOSE_VERBOSE:-0}"
TESTKIT_COMPOSE_FILTER="${TESTKIT_COMPOSE_FILTER:-1}"

pick_env_file() {
  local override="${TESTKIT_ENV_FILE:-}"
  if [[ -n "$override" ]]; then
    if [[ -f "$override" ]]; then
      echo "$override"; return 0
    fi
    echo ""; return 1
  fi

  local a="${PROJECT_ROOT}/test/.env.test"
  local b="${PROJECT_ROOT}/.env.test"
  if [[ -f "$a" ]]; then echo "$a"; return 0; fi
  if [[ -f "$b" ]]; then echo "$b"; return 0; fi
  echo ""; return 1
}

env_file_to_container_db_env_path() {
  local env_file="$1"
  if [[ "$env_file" == "${PROJECT_ROOT}/.env.test" ]]; then
    echo "/workspace/project/.env.test"; return 0
  fi
  local rel
  rel="${env_file#"${PROJECT_ROOT}/"}"
  echo "/workspace/project/${rel}"; return 0
}

port_in_use() {
  local port="$1"
  [[ -z "$port" ]] && return 2
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$port" <<'PY'
import socket, sys
port = int(sys.argv[1])
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    s.bind(('127.0.0.1', port))
except OSError:
    sys.exit(0)
finally:
    try: s.close()
    except Exception: pass
sys.exit(1)
PY
    return $?
  fi
  return 2
}

load_env_kv_safe() {
  local f="$1"
  [[ ! -f "$f" ]] && return 1
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    if [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
      export "$line"
    fi
  done < "$f"
}

normalize_stack_csv() {
  local raw="${1:-}"
  local fallback="mysql,redis"
  if [[ -z "${raw//[[:space:]]/}" ]]; then
    raw="$fallback"
  fi

  local out=()
  local seen="," 
  local IFS=','
  read -r -a parts <<< "$raw"
  for part in "${parts[@]}"; do
    local token
    token="$(echo "$part" | tr '[:upper:]' '[:lower:]' | xargs)"
    [[ -z "$token" ]] && continue
    case "$token" in
      mysql|redis|pg|postgres|postgresql)
        [[ "$token" == "postgres" || "$token" == "postgresql" ]] && token="pg"
        if [[ "$seen" != *",$token,"* ]]; then
          out+=("$token")
          seen+="$token,"
        fi
        ;;
      *)
        echo "TESTKIT_STACK inválido: token no reconocido '$token'. Valores válidos: mysql, redis, pg" >&2
        exit 1
        ;;
    esac
  done

  if [[ ${#out[@]} -eq 0 ]]; then
    out=(mysql redis)
  fi

  local joined=""
  local i
  for i in "${!out[@]}"; do
    [[ $i -gt 0 ]] && joined+="," 
    joined+="${out[$i]}"
  done
  echo "$joined"
}

stack_has() {
  local csv="$1"
  local token="$2"
  [[ ",$csv," == *",$token,"* ]]
}

resolve_compose_files() {
  local stack_csv="$1"
  local -n out_ref=$2

  out_ref=( -f "$BASE" )
  if stack_has "$stack_csv" "mysql"; then
    out_ref+=( -f "$MYSQL" )
  fi
  if stack_has "$stack_csv" "redis"; then
    out_ref+=( -f "$REDIS" )
  fi
  if stack_has "$stack_csv" "pg"; then
    out_ref+=( -f "$PG" )
  fi
}

artifact_paths_for_repair() {
  printf '%s\n' \
    "${PROJECT_ROOT}/.testkit" \
    "${PROJECT_ROOT}/test/.testkit" \
    "${PROJECT_ROOT}/test/history" \
    "${PROJECT_ROOT}/test/reports"
}

artifact_ownership_needs_repair() {
  local path
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    if [[ -e "$path" && ! -w "$path" ]]; then
      return 0
    fi
  done < <(artifact_paths_for_repair)

  return 1
}

compose_status_noise() {
  local line="${1%$'\r'}"
  [[ -z "$line" ]] && return 1

  [[ "$line" =~ ^\[\+\] ]] && return 0
  [[ "$line" =~ ^[[:space:]]*✔[[:space:]]+Container[[:space:]].*[[:space:]]+(Running|Healthy|Created|Started|Recreated)[[:space:]]+[0-9.]+s[[:space:]]*$ ]] && return 0
  [[ "$line" =~ ^Container[[:space:]].*[[:space:]](Waiting|Healthy|Creating|Created|Started|Running|Recreated|Starting|Stopping|Stopped|Removing|Removed|Restarting)[[:space:]]*$ ]] && return 0
  [[ "$line" =~ ^Found[[:space:]]orphan[[:space:]]containers ]] && return 0
  [[ "$line" =~ ^To[[:space:]]remove[[:space:]]them,[[:space:]]run[[:space:]]this[[:space:]]command[[:space:]]with[[:space:]]the[[:space:]]--remove-orphans[[:space:]]flag\.[[:space:]]*$ ]] && return 0

  return 1
}

run_docker_compose() {
  if [[ "$TESTKIT_COMPOSE_VERBOSE" == "1" || "$TESTKIT_COMPOSE_FILTER" == "0" ]]; then
    docker compose "$@"
    return $?
  fi

  if ! command -v python3 >/dev/null 2>&1; then
    docker compose --ansi never "$@"
    return $?
  fi

  python3 - "$@" <<'PY'
import re
import subprocess
import sys

noise_patterns = [
    r'^\[\+\]',
    r'^\s*✔\s+Container\s+.*\s+(?:Running|Healthy|Created|Started|Recreated)\s+[0-9.]+s\s*$',
    r'^Container\s+.*\s(?:Waiting|Healthy|Creating|Created|Started|Running|Recreated|Starting|Stopping|Stopped|Removing|Removed|Restarting)\s*$',
    r'^Found\s+orphan\s+containers',
    r'^To\s+remove\s+them,\s+run\s+this\s+command\s+with\s+the\s+--remove-orphans\s+flag\.\s*$',
]


def is_noise(line: str) -> bool:
    line = line.rstrip('\r')
    if not line:
        return False
    return any(re.match(pattern, line) for pattern in noise_patterns)

cmd = ['docker', 'compose', '--ansi', 'never', *sys.argv[1:]]
proc = subprocess.Popen(
    cmd,
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
    bufsize=0,
)
assert proc.stdout is not None
buffer = bytearray()

while True:
    chunk = proc.stdout.read(1)
    if not chunk:
        break
    if chunk == b'\r':
        line = buffer.decode('utf-8', errors='replace')
        buffer.clear()
        if line and not is_noise(line):
            sys.stdout.write(line + '\n')
            sys.stdout.flush()
        continue
    if chunk == b'\n':
        line = buffer.decode('utf-8', errors='replace')
        buffer.clear()
        if not is_noise(line):
            sys.stdout.write(line + '\n')
            sys.stdout.flush()
        continue
    buffer.extend(chunk)

if buffer:
    line = buffer.decode('utf-8', errors='replace')
    if not is_noise(line):
        sys.stdout.write(line)
        if not line.endswith('\n'):
            sys.stdout.write('\n')
        sys.stdout.flush()

sys.exit(proc.wait())
PY
}


repair_derived_artifact_ownership_if_needed() {
  artifact_ownership_needs_repair || return 0

  local repair_cmd="
    mkdir -p /workspace/project/.testkit /workspace/project/test/.testkit /workspace/project/test/history /workspace/project/test/reports && \
    chown -R ${TESTKIT_HOST_UID}:${TESTKIT_HOST_GID} \
      /workspace/project/.testkit \
      /workspace/project/test/.testkit \
      /workspace/project/test/history \
      /workspace/project/test/reports
  "

  docker compose --env-file "$ENV_FILE" "${FILES[@]}" run --rm --user 0:0 testkit sh -lc "$repair_cmd" >/dev/null
}

rewrite_run_command_args() {
  local -a args=("$@")
  if [[ ${#args[@]} -eq 0 || "${args[0]}" != "run" ]]; then
    printf '%s\0' "${args[@]}"
    return 0
  fi

  local -a rewritten=()
  local saw_testkit=0

  for arg in "${args[@]}"; do
    if [[ "$arg" == "testkit" ]]; then
      saw_testkit=1
      rewritten+=("$arg")
      continue
    fi

    if [[ $saw_testkit -eq 1 ]]; then
      case "$arg" in
        runTest.php|./runTest.php|/workspace/project/runTest.php|/workspace/testkit/runTest.php)
          rewritten+=("/workspace/testkit/runTest.php")
          continue
          ;;
        scripts/report.php|./scripts/report.php|/workspace/project/scripts/report.php|/workspace/testkit/scripts/report.php)
          rewritten+=("/workspace/testkit/scripts/report.php")
          continue
          ;;
        scripts/query_report.php|./scripts/query_report.php|/workspace/project/scripts/query_report.php|/workspace/testkit/scripts/query_report.php)
          rewritten+=("/workspace/testkit/scripts/query_report.php")
          continue
          ;;
        scripts/inspect.php|./scripts/inspect.php|/workspace/project/scripts/inspect.php|/workspace/testkit/scripts/inspect.php)
          rewritten+=("/workspace/testkit/scripts/inspect.php")
          continue
          ;;
        scripts/agent-run.php|./scripts/agent-run.php|/workspace/project/scripts/agent-run.php|/workspace/testkit/scripts/agent-run.php)
          rewritten+=("/workspace/testkit/scripts/agent-run.php")
          continue
          ;;
        runners/runTest.php|./runners/runTest.php|/workspace/project/runners/runTest.php|/workspace/testkit/runners/runTest.php)
          rewritten+=("/workspace/testkit/runners/runTest.php")
          continue
          ;;
      esac
    fi

    rewritten+=("$arg")
  done

  printf '%s\0' "${rewritten[@]}"
}

_dump_config() {
  echo ""
  echo "-- Effective TestKit config --"
  echo "projectRoot: ${PROJECT_ROOT}"
  echo "testkitRootHost: ${TESTKIT_ROOT_HOST}"
  echo "envFile:  ${ENV_FILE}"
  echo "DB_ENV_PATH(in-container): ${TESTKIT_DB_ENV_PATH}"
  echo ""
  echo "TESTKIT_STACK: ${TESTKIT_STACK_EFFECTIVE}"
  echo ""
  echo "TK_BACK_DIR:   ${TK_BACK_DIR:-back}"
  echo "TK_PUBLIC_DIR: ${TK_PUBLIC_DIR:-public_html}"
  echo ""
  echo "TEST_JOBS: ${TEST_JOBS:-1}"
  echo "TEST_DB_STRATEGY: ${TEST_DB_STRATEGY:-shared}"
  echo "TEST_DB_WORKER_SUFFIX_FORMAT: ${TEST_DB_WORKER_SUFFIX_FORMAT:-_w%02d}"
  echo "TEST_STORE_PROVISION: ${TEST_STORE_PROVISION:-managed}"
  echo "TESTKIT_COMPOSE_VERBOSE: ${TESTKIT_COMPOSE_VERBOSE}"
  echo ""
}

env_any() {
  local key
  for key in "$@"; do
    local value="${!key:-}"
    if [[ -n "${value//[[:space:]]/}" ]]; then
      echo "$value"
      return 0
    fi
  done
  return 1
}

env_present_any() {
  env_any "$@" >/dev/null 2>&1
}

path_is_under_root() {
  local root="$1"
  local target="$2"
  [[ "$target" == "$root" || "$target" == "$root/"* ]]
}

doctor_contract_checks() {
  local ok_ref_name="$1"
  local -n ok_ref="$ok_ref_name"

  local store_driver
  store_driver="$(echo "${TEST_STORE_DRIVER:-mysql}" | tr '[:upper:]' '[:lower:]' | xargs)"
  local provision_mode
  provision_mode="$(echo "${TEST_STORE_PROVISION:-managed}" | tr '[:upper:]' '[:lower:]' | xargs)"
  if [[ "$provision_mode" != "managed" && "$provision_mode" != "external" ]]; then
    echo "[FAIL] TEST_STORE_PROVISION inválido: ${TEST_STORE_PROVISION:-}. Valores válidos: managed|external"; ok_ref=0
    provision_mode="managed"
  else
    echo "[INFO] TEST_STORE_PROVISION=${provision_mode}"
  fi

  if ! path_is_under_root "$PROJECT_ROOT" "$ENV_FILE"; then
    echo "[FAIL] TESTKIT_ENV_FILE / env detectado fuera del repo montado: ${ENV_FILE}"
    echo "       Debe vivir dentro de ${PROJECT_ROOT} para que DB_ENV_PATH sea válido dentro del contenedor."
    ok_ref=0
  fi

  if [[ "$store_driver" == "mysql" ]]; then
    env_present_any DB_HOST TEST_MYSQL_HOST MYSQL_HOST \
      && echo "[OK] MySQL host present" \
      || { echo "[FAIL] falta host MySQL (DB_HOST / TEST_MYSQL_HOST / MYSQL_HOST)"; ok_ref=0; }

    env_present_any DB_PORT TEST_MYSQL_PORT MYSQL_PORT \
      && echo "[OK] MySQL port present" \
      || { echo "[FAIL] falta puerto MySQL (DB_PORT / TEST_MYSQL_PORT / MYSQL_PORT)"; ok_ref=0; }

    env_present_any DB_NAME TEST_MYSQL_DB MYSQL_DATABASE \
      && echo "[OK] MySQL database name present" \
      || { echo "[FAIL] falta nombre de DB MySQL (DB_NAME / TEST_MYSQL_DB / MYSQL_DATABASE)"; ok_ref=0; }

    env_present_any DB_USER TEST_MYSQL_USER MYSQL_USER \
      && echo "[OK] MySQL runtime user present" \
      || { echo "[FAIL] falta usuario runtime MySQL (DB_USER / TEST_MYSQL_USER / MYSQL_USER)"; ok_ref=0; }

    env_present_any DB_PASS TEST_MYSQL_PASSWORD MYSQL_PASSWORD \
      && echo "[OK] MySQL runtime password present" \
      || { echo "[FAIL] falta password runtime MySQL (DB_PASS / TEST_MYSQL_PASSWORD / MYSQL_PASSWORD)"; ok_ref=0; }

    if [[ "$provision_mode" == "managed" ]]; then
      env_present_any TEST_MYSQL_ADMIN_USER MYSQL_ROOT_USER \
        && echo "[OK] MySQL admin user present (managed provision)" \
        || { echo "[FAIL] falta usuario admin MySQL (TEST_MYSQL_ADMIN_USER / MYSQL_ROOT_USER) para TEST_STORE_PROVISION=managed"; ok_ref=0; }

      env_present_any TEST_MYSQL_ROOT_PASSWORD MYSQL_ROOT_PASSWORD \
        && echo "[OK] MySQL admin password present (managed provision)" \
        || { echo "[FAIL] falta password admin MySQL (TEST_MYSQL_ROOT_PASSWORD / MYSQL_ROOT_PASSWORD) para TEST_STORE_PROVISION=managed"; ok_ref=0; }
    else
      echo "[INFO] TEST_STORE_PROVISION=external -> no se requieren credenciales admin MySQL"
    fi
  fi

  if command -v docker >/dev/null 2>&1; then
    echo "[OK] docker command found"
  else
    echo "[FAIL] docker no está disponible en PATH"; ok_ref=0
  fi
}

doctor() {
  local ok=1
  echo ""
  echo -e "\033[1m== TESTKIT DOCTOR ==\033[0m"

  ENV_FILE="$(pick_env_file || true)"
  if [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]]; then
    ENV_FILE="$(cd "$(dirname "$ENV_FILE")" && pwd)/$(basename "$ENV_FILE")"
    echo "[OK] env: ${ENV_FILE}"
    load_env_kv_safe "$ENV_FILE" || true
  else
    echo "[FAIL] falta env de tests: test/.env.test (preferido) o .env.test (root)."; ok=0
  fi

  TESTKIT_STACK_EFFECTIVE="$(normalize_stack_csv "${TESTKIT_STACK:-}")"
  echo "[INFO] TESTKIT_STACK=${TESTKIT_STACK_EFFECTIVE}"
  echo "[INFO] TESTKIT_ROOT(host)=${TESTKIT_ROOT_HOST}"
  echo "[INFO] TESTKIT_PROJECT_ROOT(host)=${PROJECT_ROOT}"
  echo "[INFO] TESTKIT_HOST_UID:GID=${TESTKIT_HOST_UID}:${TESTKIT_HOST_GID}"

  if [[ ! -d "$TESTKIT_ROOT_HOST" ]]; then
    echo "[FAIL] TESTKIT_ROOT no existe o no es directorio: ${TESTKIT_ROOT_HOST}"; ok=0
  elif [[ ! -f "$TESTKIT_ROOT_HOST/runTest.php" ]]; then
    echo "[FAIL] TESTKIT_ROOT no parece repo completo: falta runTest.php en ${TESTKIT_ROOT_HOST}"; ok=0
  else
    echo "[OK] TESTKIT_ROOT: ${TESTKIT_ROOT_HOST}"
  fi

  if [[ ! -d "$PROJECT_ROOT" ]]; then
    echo "[FAIL] TESTKIT_PROJECT_ROOT no existe o no es directorio: ${PROJECT_ROOT}"; ok=0
  else
    echo "[OK] TESTKIT_PROJECT_ROOT: ${PROJECT_ROOT}"
  fi

  local test_out_dir="${PROJECT_ROOT}/test"
  mkdir -p "${test_out_dir}" >/dev/null 2>&1 || true
  if [[ -w "${test_out_dir}" ]]; then
    echo "[OK] ${test_out_dir} writable"
  else
    echo "[FAIL] ${test_out_dir} no es escribible"; ok=0
  fi

  if [[ -n "${ENV_FILE:-}" && -f "${ENV_FILE:-}" ]]; then
    doctor_contract_checks ok
  fi

  if [[ "${2:-}" == "--dump" && -n "${ENV_FILE:-}" ]]; then
    export TESTKIT_DB_ENV_PATH="$(env_file_to_container_db_env_path "$ENV_FILE")"
    export TESTKIT_PROJECT_ROOT="$PROJECT_ROOT"
    export TESTKIT_ROOT="$TESTKIT_ROOT_HOST"
    _dump_config
  fi

  if [[ "$ok" -eq 1 ]]; then
    echo ""
    echo "Doctor: OK"
    return 0
  fi
  echo ""
  echo "Doctor: FAIL (ver arriba)" >&2
  return 1
}

if [[ "${1:-}" == "doctor" ]]; then
  doctor "$@"
  exit $?
fi

ENV_FILE="$(pick_env_file || true)"
if [[ -z "${ENV_FILE}" || ! -f "${ENV_FILE}" ]]; then
  echo "Falta env de tests en el proyecto. Creá <project>/test/.env.test o <project>/.env.test." >&2
  exit 1
fi
ENV_FILE="$(cd "$(dirname "$ENV_FILE")" && pwd)/$(basename "$ENV_FILE")"

if ! path_is_under_root "$PROJECT_ROOT" "$ENV_FILE"; then
  echo "El env de tests quedó fuera del repo montado: ${ENV_FILE}" >&2
  echo "Movelo a <project>/test/.env.test o <project>/.env.test." >&2
  exit 1
fi

load_env_kv_safe "$ENV_FILE" || true

legacy_pg_flag=0
if [[ "${1:-}" == "--pg" ]]; then
  legacy_pg_flag=1
  shift
fi

TESTKIT_STACK_EFFECTIVE="$(normalize_stack_csv "${TESTKIT_STACK:-}")"
if [[ "$legacy_pg_flag" -eq 1 ]] && ! stack_has "$TESTKIT_STACK_EFFECTIVE" "pg"; then
  TESTKIT_STACK_EFFECTIVE="${TESTKIT_STACK_EFFECTIVE},pg"
fi

export TESTKIT_DB_ENV_PATH="$(env_file_to_container_db_env_path "$ENV_FILE")"
export TESTKIT_PROJECT_ROOT="$PROJECT_ROOT"
export TESTKIT_ROOT="$TESTKIT_ROOT_HOST"
export TESTKIT_HOST_UID
export TESTKIT_HOST_GID

FILES=()
resolve_compose_files "$TESTKIT_STACK_EFFECTIVE" FILES
repair_derived_artifact_ownership_if_needed

if [[ "${1:-}" == "inspect" ]]; then
  shift
  run_docker_compose --env-file "$ENV_FILE" "${FILES[@]}" run --rm testkit php /workspace/testkit/scripts/inspect.php "$@"
  exit $?
fi

mapfile -d '' -t REWRITTEN_ARGS < <(rewrite_run_command_args "$@")

run_docker_compose --env-file "$ENV_FILE" "${FILES[@]}" "${REWRITTEN_ARGS[@]}"
exit $?
