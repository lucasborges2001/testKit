#!/usr/bin/env bash
set -euo pipefail

TESTKIT_ENTRY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=/dev/null
source "${TESTKIT_ENTRY_DIR}/lib/bash/env.sh"
# shellcheck source=/dev/null
source "${TESTKIT_ENTRY_DIR}/lib/bash/stack.sh"
# shellcheck source=/dev/null
source "${TESTKIT_ENTRY_DIR}/lib/bash/rewrite.sh"
# shellcheck source=/dev/null
source "${TESTKIT_ENTRY_DIR}/lib/bash/doctor.sh"

testkit_env_init

testkit_configure_compose_progress() {
  if [[ -n "${COMPOSE_PROGRESS:-}" ]]; then
    return 0
  fi
  if [[ "${TESTKIT_CONSOLE_MODE:-compact}" != "live" ]]; then
    export COMPOSE_PROGRESS=quiet
  fi
}

testkit_docker_passthrough_env_args() {
  local out=()
  local key
  for key in TEST_COVERAGE_DIR TEST_COVERAGE_ROOT; do
    if [[ -n "${!key:-}" ]]; then
      out+=("-e" "${key}")
    fi
  done
  if [[ ${#out[@]} -gt 0 ]]; then
    printf '%s\0' "${out[@]}"
  fi
}

testkit_dispatch_doctor() {
  testkit_doctor_run "$@"
}

testkit_dispatch_inspect() {
  local env_file="$1"
  shift || true
  local stack_csv
  stack_csv="$(testkit_normalize_stack_csv "${TESTKIT_STACK:-}")" || return 1
  export TESTKIT_DB_ENV_PATH
  TESTKIT_DB_ENV_PATH="$(testkit_env_file_to_container_path "${env_file}")"
  export TESTKIT_PROJECT_ROOT="${PROJECT_ROOT}"
  export TESTKIT_ROOT="${TESTKIT_ROOT_HOST}"
  local files=()
  testkit_resolve_compose_files "${stack_csv}" files
  docker compose --env-file "${env_file}" "${files[@]}" run --rm \
    -e TESTKIT_WRAPPER_KIND="bash" \
    testkit php /workspace/testkit/scripts/inspect.php "$@"
}

testkit_dispatch_cleanup() {
  local env_file="$1"
  shift || true
  local stack_csv
  stack_csv="$(testkit_normalize_stack_csv "${TESTKIT_STACK:-}")" || return 1
  export TESTKIT_DB_ENV_PATH
  TESTKIT_DB_ENV_PATH="$(testkit_env_file_to_container_path "${env_file}")"
  export TESTKIT_PROJECT_ROOT="${PROJECT_ROOT}"
  export TESTKIT_ROOT="${TESTKIT_ROOT_HOST}"
  local files=()
  testkit_resolve_compose_files "${stack_csv}" files
  local passthrough_env=()
  mapfile -d '' -t passthrough_env < <(testkit_docker_passthrough_env_args)
  docker compose --env-file "${env_file}" "${files[@]}" run --rm \
    -e TESTKIT_WRAPPER_KIND="bash" \
    "${passthrough_env[@]}" \
    testkit php /workspace/testkit/scripts/cleanup.php "$@"
}

testkit_dispatch_runtime() {
  local env_file="$1"
  shift || true
  local legacy_pg_flag=0
  if [[ "${1:-}" == "--pg" ]]; then
    legacy_pg_flag=1
    shift || true
  fi
  local stack_csv
  stack_csv="$(testkit_normalize_stack_csv "${TESTKIT_STACK:-}")" || return 1
  if [[ "${legacy_pg_flag}" -eq 1 ]] && ! testkit_stack_has "${stack_csv}" "pg"; then
    stack_csv="${stack_csv},pg"
  fi
  export TESTKIT_DB_ENV_PATH
  TESTKIT_DB_ENV_PATH="$(testkit_env_file_to_container_path "${env_file}")"
  export TESTKIT_PROJECT_ROOT="${PROJECT_ROOT}"
  export TESTKIT_ROOT="${TESTKIT_ROOT_HOST}"
  local files=()
  testkit_resolve_compose_files "${stack_csv}" files
  local rewritten=()
  mapfile -d '' -t rewritten < <(testkit_rewrite_run_command_args "$@")
  local compose_cmd=(
    docker compose
    --env-file "${env_file}"
    "${files[@]}"
    "${rewritten[@]}"
  )
  if [[ "${TESTKIT_DEBUG_WRAPPER:-0}" == "1" ]]; then
    printf '[testkit] exec:' >&2
    printf ' %q' "${compose_cmd[@]}" >&2
    printf '\n' >&2
  fi
  "${compose_cmd[@]}"
}

testkit_dispatch_sql_observability() {
  local list_only=0
  local -a args=("$@")
  local i
  for ((i = 0; i < ${#args[@]}; i++)); do
    case "${args[$i]}" in
      -e)
        if [[ $((i + 1)) -lt ${#args[@]} ]]; then
          export "${args[$((i + 1))]}"
          i=$((i + 1))
        fi
        ;;
      -e=*) export "${args[$i]#-e=}" ;;
      --list) list_only=1 ;;
    esac
  done
  export TESTKIT_PROJECT_ROOT="${PROJECT_ROOT}"
  export TK_REPO_ROOT="${PROJECT_ROOT}"
  export TESTKIT_ROOT="${TESTKIT_ROOT_HOST}"
  if [[ -n "${TESTKIT_SQL_OBSERVABILITY_CONFIG:-}" ]]; then
    export SQLOBS_HOST_CONFIG="${TESTKIT_SQL_OBSERVABILITY_CONFIG}"
  fi
  if [[ "${list_only}" -eq 1 ]]; then
    export TEST_LIST=1
  fi
  php "${TESTKIT_ROOT_HOST}/runTest.php" sql-observability
}

testkit_is_sql_observability_command() {
  local joined=" $* "
  [[ "${joined}" == *" runTest.php sql-observability "* || "${joined}" == *" /workspace/testkit/runTest.php sql-observability "* ]]
}

main() {
  local cmd="${1:-}"
  case "${cmd}" in
    doctor)
      shift || true
      testkit_dispatch_doctor "$@"
      return $?
      ;;
  esac

  local env_file
  env_file="$(testkit_pick_env_file || true)"
  if [[ -z "${env_file}" || ! -f "${env_file}" ]]; then
    echo "Falta env de tests en el proyecto. Creá <project>/test/.env.test o <project>/.env.test." >&2
    return 1
  fi
  env_file="$(cd "$(dirname "${env_file}")" && pwd)/$(basename "${env_file}")"
  if ! testkit_path_is_under_root "${PROJECT_ROOT}" "${env_file}"; then
    echo "El env de tests quedó fuera del repo montado: ${env_file}" >&2
    return 1
  fi
  testkit_load_env_kv_safe "${env_file}" || true
  testkit_configure_compose_progress

  if testkit_is_sql_observability_command "$@"; then
    testkit_dispatch_sql_observability "$@"
    return $?
  fi
  case "${cmd}" in
    inspect)
      shift || true
      testkit_dispatch_inspect "${env_file}" "$@"
      return $?
      ;;
    cleanup)
      shift || true
      testkit_dispatch_cleanup "${env_file}" "$@"
      return $?
      ;;
    *)
      testkit_dispatch_runtime "${env_file}" "$@"
      return $?
      ;;
  esac
}

main "$@"
