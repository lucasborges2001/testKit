#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BASE="${HERE}/compose.yaml"
PG="${HERE}/compose.pg.yaml"
ROOT="$(cd "${HERE}/.." && pwd)"

pick_env_file() {
  local override="${TESTKIT_ENV_FILE:-}"
  if [[ -n "$override" ]]; then
    [[ -f "$override" ]] && { echo "$override"; return 0; }
    echo ""; return 1
  fi
  local a="${HERE}/.env.test"
  local b="${ROOT}/.env.test"
  [[ -f "$a" ]] && { echo "$a"; return 0; }
  [[ -f "$b" ]] && { echo "$b"; return 0; }
  echo ""; return 1
}

env_file_to_container_db_env_path() {
  local env_file="$1"
  if [[ "$env_file" == "${HERE}/.env.test" ]]; then echo "/app/test/.env.test"; return 0; fi
  if [[ "$env_file" == "${ROOT}/.env.test" ]]; then echo "/app/.env.test"; return 0; fi
  local rel
  rel="${env_file#"${ROOT}/"}"
  echo "/app/${rel}"
}

truthy() {
  local v="${1:-}"
  [[ -z "$v" ]] && return 1
  v="${v,,}"
  [[ "$v" == "1" || "$v" == "true" || "$v" == "yes" || "$v" == "y" || "$v" == "on" ]]
}

project_name() {
  if [[ -n "${TESTKIT_PROJECT:-}" ]]; then echo "$TESTKIT_PROJECT"; return 0; fi
  if [[ -n "${COMPOSE_PROJECT_NAME:-}" ]]; then echo "$COMPOSE_PROJECT_NAME"; return 0; fi
  echo "$(basename "$HERE")"
}

pg_running() {
  local proj="$1"
  docker ps --format '{{.Names}}' 2>/dev/null | grep -Eq "^${proj}-postgres_test-" || return 1
  return 0
}

if [[ ${#} -eq 0 || "${1:-}" =~ ^(-h|--help|help)$ ]]; then
  cat <<'EOF'
TestKit (Unix)

Uso:
  ./bin/testkit doctor
  ./bin/testkit [pg|nopg] <docker compose args...>

Atajos:
  pg    = incluye compose.pg.yaml (Postgres)
  nopg  = fuerza modo sin Postgres

Modo auto (default):
  - Si postgres_test está corriendo, incluye compose.pg.yaml automáticamente.
  - Podés forzar default con TESTKIT_DEFAULT_PG=1
EOF
  exit 0
fi

if [[ "${1:-}" == "doctor" ]]; then
  echo "== TestKit doctor =="
  ENV_FILE="$(pick_env_file || true)"
  [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]] && echo "[OK] env: $ENV_FILE" || { echo "[FAIL] falta env"; exit 1; }
  docker --version >/dev/null 2>&1 && echo "[OK] docker CLI" || { echo "[FAIL] docker"; exit 1; }
  docker info >/dev/null 2>&1 && echo "[OK] docker daemon" || { echo "[FAIL] docker daemon"; exit 1; }
  docker compose version >/dev/null 2>&1 && echo "[OK] docker compose v2" || { echo "[FAIL] docker compose"; exit 1; }
  echo ""; echo "Doctor: OK"; exit 0
fi

ENV_FILE="$(pick_env_file || true)"
[[ -n "$ENV_FILE" && -f "$ENV_FILE" ]] || { echo "Falta env de tests" >&2; exit 1; }
export TESTKIT_DB_ENV_PATH="$(env_file_to_container_db_env_path "$ENV_FILE")"

MODE_PG=0
truthy "${TESTKIT_DEFAULT_PG:-}" && MODE_PG=1

case "${1:-}" in
  --pg|pg) MODE_PG=1; shift ;;
  --nopg|nopg) MODE_PG=0; shift ;;
esac

if [[ "$MODE_PG" -eq 0 ]] && ! truthy "${TESTKIT_DISABLE_AUTO_PG:-}"; then
  PROJ="$(project_name)"
  if pg_running "$PROJ"; then MODE_PG=1; fi
fi

FILES=( -f "$BASE" )
[[ "$MODE_PG" -eq 1 ]] && FILES+=( -f "$PG" )

exec docker compose --env-file "$ENV_FILE" "${FILES[@]}" "$@"
