#!/usr/bin/env bash
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BASE="${HERE}/compose.yaml"
MYSQL="${HERE}/compose.mysql.yaml"
REDIS="${HERE}/compose.redis.yaml"
PG="${HERE}/compose.pg.yaml"

PROJECT_ROOT="${TESTKIT_PROJECT_ROOT:-}"
if [[ -z "${PROJECT_ROOT}" ]]; then
  PROJECT_ROOT="$(cd "${HERE}/.." && pwd)"
fi
PROJECT_ROOT="$(cd "${PROJECT_ROOT}" && pwd)"

TESTKIT_ROOT_HOST="${TESTKIT_ROOT:-$HERE}"
TESTKIT_ROOT_HOST="$(cd "${TESTKIT_ROOT_HOST}" && pwd)"

DOCTOR_DOCKER_MODE="${TESTKIT_DOCTOR_DOCKER_MODE:-auto}"

pick_env_file() {
  local override="${TESTKIT_ENV_FILE:-}"
  if [[ -n "$override" ]]; then
    if [[ -f "$override" ]]; then
      echo "$override"; return 0
    fi
    echo ""; return 1
  fi

  local a="${PROJECT_ROOT}/test/.env.test"
  local b="${PROJECT_ROOT}/.env.test"
  if [[ -f "$a" ]]; then echo "$a"; return 0; fi
  if [[ -f "$b" ]]; then echo "$b"; return 0; fi
  echo ""; return 1
}

env_file_to_container_db_env_path() {
  local env_file="$1"
  if [[ "$env_file" == "${PROJECT_ROOT}/.env.test" ]]; then
    echo "/workspace/project/.env.test"; return 0
  fi
  local rel
  rel="${env_file#"${PROJECT_ROOT}/"}"
  echo "/workspace/project/${rel}"; return 0
}

port_in_use() {
  local port="$1"
  [[ -z "$port" ]] && return 2
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$port" <<'PY'
import socket, sys
port = int(sys.argv[1])
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
try:
    s.bind(('127.0.0.1', port))
except OSError:
    sys.exit(0)
finally:
    try: s.close()
    except Exception: pass
sys.exit(1)
PY
    return $?
  fi
  return 2
}

load_env_kv_safe() {
  local f="$1"
  [[ ! -f "$f" ]] && return 1
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    if [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
      export "$line"
    fi
  done < "$f"
}

normalize_stack_csv() {
  local raw="${1:-}"
  local fallback="mysql,redis"
  if [[ -z "${raw//[[:space:]]/}" ]]; then
    raw="$fallback"
  fi

  local out=()
  local seen=","
  local IFS=','
  read -r -a parts <<< "$raw"
  for part in "${parts[@]}"; do
    local token
    token="$(echo "$part" | tr '[:upper:]' '[:lower:]' | xargs)"
    [[ -z "$token" ]] && continue
    case "$token" in
      mysql|redis|pg|postgres|postgresql)
        [[ "$token" == "postgres" || "$token" == "postgresql" ]] && token="pg"
        if [[ "$seen" != *",$token,"* ]]; then
          out+=("$token")
          seen+="$token,"
        fi
        ;;
      *)
        echo "TESTKIT_STACK inválido: token no reconocido '$token'. Valores válidos: mysql, redis, pg" >&2
        exit 1
        ;;
    esac
  done

  if [[ ${#out[@]} -eq 0 ]]; then
    out=(mysql redis)
  fi

  local joined=""
  local i
  for i in "${!out[@]}"; do
    [[ $i -gt 0 ]] && joined+=","
    joined+="${out[$i]}"
  done
  echo "$joined"
}

stack_has() {
  local csv="$1"
  local token="$2"
  [[ ",$csv," == *",$token,"* ]]
}

resolve_compose_files() {
  local stack_csv="$1"
  local -n out_ref=$2

  out_ref=( -f "$BASE" )
  if stack_has "$stack_csv" "mysql"; then
    out_ref+=( -f "$MYSQL" )
  fi
  if stack_has "$stack_csv" "redis"; then
    out_ref+=( -f "$REDIS" )
  fi
  if stack_has "$stack_csv" "pg"; then
    out_ref+=( -f "$PG" )
  fi
}

rewrite_run_command_args() {
  local -a args=("$@")
  if [[ ${#args[@]} -eq 0 || "${args[0]}" != "run" ]]; then
    printf '%s\0' "${args[@]}"
    return 0
  fi

  local -a rewritten=()
  local saw_testkit=0

  for arg in "${args[@]}"; do
    if [[ "$arg" == "testkit" ]]; then
      saw_testkit=1
      rewritten+=("$arg")
      continue
    fi

    if [[ $saw_testkit -eq 1 ]]; then
      case "$arg" in
        runTest.php|./runTest.php|/workspace/project/runTest.php|/workspace/testkit/runTest.php)
          rewritten+=("/workspace/testkit/runTest.php")
          continue
          ;;
        scripts/report.php|./scripts/report.php|/workspace/project/scripts/report.php|/workspace/testkit/scripts/report.php)
          rewritten+=("/workspace/testkit/scripts/report.php")
          continue
          ;;
        scripts/query_report.php|./scripts/query_report.php|/workspace/project/scripts/query_report.php|/workspace/testkit/scripts/query_report.php)
          rewritten+=("/workspace/testkit/scripts/query_report.php")
          continue
          ;;
        runners/runTest.php|./runners/runTest.php|/workspace/project/runners/runTest.php|/workspace/testkit/runners/runTest.php)
          rewritten+=("/workspace/testkit/runners/runTest.php")
          continue
          ;;
      esac
    fi

    rewritten+=("$arg")
  done

  printf '%s\0' "${rewritten[@]}"
}

_dump_config() {
  echo ""
  echo "-- Effective TestKit config --"
  echo "projectRoot: ${PROJECT_ROOT}"
  echo "testkitRootHost: ${TESTKIT_ROOT_HOST}"
  echo "envFile:  ${ENV_FILE}"
  echo "DB_ENV_PATH(in-container): ${TESTKIT_DB_ENV_PATH}"
  echo ""
  echo "TESTKIT_STACK: ${TESTKIT_STACK_EFFECTIVE}"
  echo ""
  echo "TK_BACK_DIR:   ${TK_BACK_DIR:-back}"
  echo "TK_PUBLIC_DIR: ${TK_PUBLIC_DIR:-public_html}"
  echo ""
  echo "TEST_JOBS: ${TEST_JOBS:-1}"
  echo "TEST_DB_STRATEGY: ${TEST_DB_STRATEGY:-shared}"
  echo "TEST_DB_WORKER_SUFFIX_FORMAT: ${TEST_DB_WORKER_SUFFIX_FORMAT:-_w%02d}"
  echo ""
}

doctor() {
  local ok=1
  echo ""
  echo -e "\033[1m== TESTKIT DOCTOR ==\033[0m"

  ENV_FILE="$(pick_env_file || true)"
  if [[ -n "$ENV_FILE" && -f "$ENV_FILE" ]]; then
    echo "[OK] env: ${ENV_FILE}"
    load_env_kv_safe "$ENV_FILE" || true
  else
    echo "[FAIL] falta env de tests: test/.env.test (preferido) o .env.test (root)."; ok=0
  fi

  TESTKIT_STACK_EFFECTIVE="$(normalize_stack_csv "${TESTKIT_STACK:-}")"
  echo "[INFO] TESTKIT_STACK=${TESTKIT_STACK_EFFECTIVE}"
  echo "[INFO] TESTKIT_ROOT(host)=${TESTKIT_ROOT_HOST}"

  if [[ ! -d "$TESTKIT_ROOT_HOST" ]]; then
    echo "[FAIL] TESTKIT_ROOT no existe o no es directorio: ${TESTKIT_ROOT_HOST}"; ok=0
  elif [[ ! -f "$TESTKIT_ROOT_HOST/runTest.php" ]]; then
    echo "[FAIL] TESTKIT_ROOT no parece repo completo: falta runTest.php en ${TESTKIT_ROOT_HOST}"; ok=0
  else
    echo "[OK] TESTKIT_ROOT: ${TESTKIT_ROOT_HOST}"
  fi

  local test_out_dir="${PROJECT_ROOT}/test"
  mkdir -p "${test_out_dir}" >/dev/null 2>&1 || true
  if [[ -w "${test_out_dir}" ]]; then
    echo "[OK] ${test_out_dir} writable"
  else
    echo "[FAIL] ${test_out_dir} no es escribible"; ok=0
  fi

  if [[ "${2:-}" == "--dump" ]]; then
    export TESTKIT_DB_ENV_PATH="$(env_file_to_container_db_env_path "$ENV_FILE")"
    export TESTKIT_PROJECT_ROOT="$PROJECT_ROOT"
    export TESTKIT_ROOT="$TESTKIT_ROOT_HOST"
    _dump_config
  fi

  if [[ "$ok" -eq 1 ]]; then
    echo ""
    echo "Doctor: OK"
    return 0
  fi
  echo ""
  echo "Doctor: FAIL (ver arriba)" >&2
  return 1
}

if [[ "${1:-}" == "doctor" ]]; then
  doctor "$@"
  exit $?
fi

ENV_FILE="$(pick_env_file || true)"
if [[ -z "${ENV_FILE}" || ! -f "${ENV_FILE}" ]]; then
  echo "Falta env de tests en el proyecto. Creá <project>/test/.env.test o <project>/.env.test." >&2
  exit 1
fi

load_env_kv_safe "$ENV_FILE" || true

legacy_pg_flag=0
if [[ "${1:-}" == "--pg" ]]; then
  legacy_pg_flag=1
  shift
fi

TESTKIT_STACK_EFFECTIVE="$(normalize_stack_csv "${TESTKIT_STACK:-}")"
if [[ "$legacy_pg_flag" -eq 1 ]] && ! stack_has "$TESTKIT_STACK_EFFECTIVE" "pg"; then
  TESTKIT_STACK_EFFECTIVE="${TESTKIT_STACK_EFFECTIVE},pg"
fi

export TESTKIT_DB_ENV_PATH="$(env_file_to_container_db_env_path "$ENV_FILE")"
export TESTKIT_PROJECT_ROOT="$PROJECT_ROOT"
export TESTKIT_ROOT="$TESTKIT_ROOT_HOST"

FILES=()
resolve_compose_files "$TESTKIT_STACK_EFFECTIVE" FILES

mapfile -d '' -t REWRITTEN_ARGS < <(rewrite_run_command_args "$@")

exec docker compose --env-file "$ENV_FILE" "${FILES[@]}" "${REWRITTEN_ARGS[@]}"
