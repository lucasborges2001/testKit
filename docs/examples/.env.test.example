# TestKit contract example
# Preferido: guardar este archivo en <project>/test/.env.test

# Runtime DB (siempre requerido para suites que tocan MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=kiara_test
DB_USER=test_user
DB_PASS=test_pass

# Política de provisión:
# - managed  => testkit crea/valida la base y requiere credenciales admin
# - external => la base ya existe; testkit NO exige admin
TEST_STORE_PROVISION=managed

# Solo para TEST_STORE_PROVISION=managed
TEST_MYSQL_ADMIN_USER=root
TEST_MYSQL_ROOT_PASSWORD=root

# Opcional: stack docker
TESTKIT_STACK=mysql,redis

# Opcional: layout del repo
TK_BACK_DIR=back
TK_PUBLIC_DIR=public_html

# Opcional: selección/ejecución
TEST_SCOPE=all
TEST_CATEGORY=all
TEST_FAIL_FAST=1

# Paralelismo
# - TEST_JOBS=1 => secuencial
# - TEST_JOBS>1 => paralelismo intra-suite
# - para integration/e2e con DB y TEST_JOBS>1, la única ruta segura es per_worker
TEST_JOBS=1
TEST_DB_STRATEGY=shared
TEST_DB_WORKER_SUFFIX_FORMAT=_w%02d

# Baseline / restore
# - layered  => schema/base/migrations/validations
# - snapshot => restore de dump lógico + migraciones + validations
TEST_BASELINE_MODE=layered
TEST_BASELINE_SNAPSHOT_FILE=
TEST_BASELINE_CLONE_PER_WORKER=0
TEST_BASELINE_DB_SUFFIX=_baseline
TEST_BASELINE_REUSE=0
TEST_BASELINE_INVALIDATE=0

# Target dedicado para validar migraciones contra snapshot
# Recomendado:
# TEST_BASELINE_MODE=snapshot
# TEST_BASELINE_SNAPSHOT_FILE=/workspace/project/test/seeds/mysql/baseline/latest.sql.gz
# TEST_DB_STRATEGY=shared
# php runTest.php migration-contract

# Opcional: reporting
TEST_REPORT_KEEP=5
TEST_RUNS_INDEX_KEEP=10
TEST_SLOW_THRESHOLD_MS=1500
TEST_SLOW_TOP=10


# Baseline snapshot directo
# TEST_BASELINE_MODE=snapshot
# TEST_BASELINE_SNAPSHOT_FILE=/workspace/project/test/seeds/mysql/baseline/latest.sql.gz

# Baseline resuelto desde backupkit
# Elegí una de estas rutas:
# TEST_BASELINE_BACKUPKIT_METADATA_JSON=/workspace/project/.backup/latest.sql.gz.metadata.json
# TEST_BASELINE_BACKUPKIT_REPORT_JSON=/workspace/project/.backup/restore-test-report.json
# Si está activo, testkit rechaza reportes backupkit con status final ERROR/FAIL
TEST_BASELINE_REQUIRE_BACKUPKIT_SUCCESS=1


# Detección de estado de migración
# - explicit: usa TEST_MIGRATION_APPLIED=001_init,002_acl
# - manifest_table: lee tabla/columna de migraciones existentes
# - state_files: usa test/seeds/<driver>/migrations/<id>/state.json
TEST_MIGRATION_STATE_MODE=explicit
TEST_MIGRATION_APPLIED=
TEST_MIGRATION_STATE_TABLE=
TEST_MIGRATION_STATE_COLUMN=version
TEST_MIGRATION_TARGET=latest
# Si está en 1 y no definís TEST_SEED_MIGRATIONS manualmente,
# testkit calcula las pendientes comparando applied vs target.
TEST_MIGRATION_AUTO_PENDING=1
