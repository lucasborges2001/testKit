# TestKit contract example
# Preferido: guardar este archivo en <project>/test/.env.test

# Runtime DB (siempre requerido para suites que tocan MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=kiara_test
DB_USER=test_user
DB_PASS=test_pass

# Política de provisión:
# - managed  => testkit crea/valida la base y requiere credenciales admin
# - external => la base ya existe; testkit NO exige admin
TEST_STORE_PROVISION=managed

# Solo para TEST_STORE_PROVISION=managed
TEST_MYSQL_ADMIN_USER=root
TEST_MYSQL_ROOT_PASSWORD=root

# Opcional: stack docker
TESTKIT_STACK=mysql,redis

# Opcional: layout del repo
TK_BACK_DIR=back
TK_PUBLIC_DIR=public_html

# Opcional: selección/ejecución
TEST_SCOPE=all
TEST_CATEGORY=all
TEST_FAIL_FAST=1

# Paralelismo
# - TEST_JOBS=1 => secuencial
# - TEST_JOBS>1 => paralelismo intra-suite
# - para integration/e2e con DB y TEST_JOBS>1, la única ruta segura es per_worker
TEST_JOBS=1
TEST_DB_STRATEGY=shared
TEST_DB_WORKER_SUFFIX_FORMAT=_w%02d

# Opcional: reporting
TEST_REPORT_KEEP=5
TEST_RUNS_INDEX_KEEP=10
TEST_SLOW_THRESHOLD_MS=1500
TEST_SLOW_TOP=10
