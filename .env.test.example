# ==========================================================
# TestKit — env de tests
#
# Ubicación soportada (sin ambigüedades):
# - Preferida: <repo>/test/.env.test
# - Alternativa: <repo>/.env.test
#
# 1) Copiar este ejemplo y editar:
#    - cp testkit/.env.test.example <project>/test/.env.test
#
# Nota importante:
# - bin/testkit elige automáticamente el env (test/.env.test primero, luego .env.test root)
# - Docker Compose usa el env elegido vía: docker compose --env-file <env>
# - En contenedor, DB_ENV_PATH apunta al env correcto (/app/test/.env.test o /app/.env.test)
# ==========================================================

# ==========================================================
# Paths del proyecto (portabilidad)
# ==========================================================
# El TestKit NO asume back/ ni public_html/.
# Si tu repo usa otros nombres, setealos acá.
TK_BACK_DIR=back
TK_PUBLIC_DIR=public_html

# Bootstrap / autoload (configurable por proyecto):
# - Si tu proyecto tiene Composer:
#   TK_BACK_AUTOLOAD=${TK_BACK_DIR}/vendor/autoload.php
# - Si NO tiene Composer o necesitás init extra:
#   TK_BACK_BOOTSTRAP=${TK_BACK_DIR}/bootstrap.php
#
# Para front PHP (si aplica):
#   TK_PUBLIC_AUTOLOAD=${TK_PUBLIC_DIR}/vendor/autoload.php
#   TK_PUBLIC_BOOTSTRAP=${TK_PUBLIC_DIR}/bootstrap.php
#
# Si querés que falta de bootstrap sea FAIL temprano:
# TK_REQUIRE_BOOTSTRAP=1

# JS bootstrap (runner):
#   TK_FRONT_BOOTSTRAP=testkit/front/_support/bootstrap.mjs

# ==========================================================
# Runner
# ==========================================================
APP_ENV=test
APP_DEBUG=1

# ==========================================================
# Flags de ejecución (tests)
# ==========================================================
# Target del meta-runner: all|back|front|front-php|front-js
# TEST_TARGET=all

# Filtros
# TEST_SCOPE=all          # unit|integration|e2e|all
# TEST_MATCH=             # substring sobre ruta/nombre
# TEST_LIST=0             # 1 lista y sale

# Paralelismo por archivos (los runners BACK/FRONT lo soportan)
TEST_JOBS=1

# Estrategia DB:
# - shared: una DB compartida (rápido; tus tests deben ser read-only o hacer clean manual)
# - clean: soporte para clean por test (opt-in con TEST_DB_CLEAN_*)
# - per_worker: cada worker usa su propia DB (requiere seed.sh con TEST_JOBS>1)
TEST_DB_STRATEGY=shared
TEST_DB_WORKER_SUFFIX_FORMAT=_w%02d

# Clean (opt-in):
# - TEST_DB_STRATEGY=clean
# - TEST_DB_CLEAN_EACH=1 => limpia antes de tests en /integration/ o /e2e/
# - TEST_DB_CLEAN_ALWAYS=1 => limpia antes de TODOS los tests (lento)
TEST_DB_CLEAN_EACH=0
TEST_DB_CLEAN_ALWAYS=0

# Fail-fast
# - Meta-runner: por default NO corta (TEST_META_FAIL_FAST=0)
# - Sub-runners: por default el meta-runner fuerza NO cortar (TEST_CHILD_FAIL_FAST=0)
# - Si corrés un runner suelto, default es fail-fast=1 (podés setear 0)
TEST_META_FAIL_FAST=0
TEST_CHILD_FAIL_FAST=0
# TEST_FAIL_FAST=1

# Node requerido
# - 0: si falta node => SKIP (default)
# - 1: si falta node => FAIL
TEST_JS_REQUIRE_NODE=0

# Determinismo
# - TEST_NOW: fecha fija (PHP: tk_now(); JS bootstrap: Date.now/new Date() si TEST_FREEZE_TIME=1)
# - TEST_RAND_SEED: seed para mt_rand/Math.random (JS bootstrap)
# - TEST_TZ: timezone (si querés fijarlo)
# TEST_NOW=2026-02-24T00:00:00Z
# TEST_RAND_SEED=1234
# TEST_TZ=UTC
# TEST_FREEZE_TIME=1

# ==========================================================
# MySQL (default)
# ==========================================================
TEST_MYSQL_ROOT_PASSWORD=root
TEST_MYSQL_DB=app_test
TEST_MYSQL_USER=app
TEST_MYSQL_PASSWORD=app
TEST_MYSQL_PORT=33070

# Variables que normalmente usa tu app (alinearlas con las anteriores)
DB_DRIVER=mysql
DB_HOST=mysql_test
DB_PORT=3306
DB_NAME=app_test
DB_USER=app
DB_PASS=app

# ==========================================================
# Postgres (opcional — solo si levantás con --pg)
# ==========================================================
TEST_PG_DB=app_test
TEST_PG_USER=app
TEST_PG_PASSWORD=app
TEST_PG_PORT=54370

PG_HOST=postgres_test
PG_PORT=5432
PG_DB=app_test
PG_USER=app
PG_PASS=app

# ==========================================================
# JS loader
# ==========================================================
# Si tus tests de JS importan desde test/front pero el código vive en TK_PUBLIC_DIR,
# dejalo en 1 para redirigir imports.
TEST_USE_PUBLIC_LOADER=1
TEST_IMPORT_DEBUG=0

# ==========================================================
# Coverage (los runners lo leen)
# ==========================================================
TEST_COVERAGE=0
TEST_COVERAGE_FORMAT=lcov
# Si querés un directorio único, usá esto (los runners también tienen defaults por suite)
# TEST_COVERAGE_DIR=/workspace/testkit/_out/coverage

# ==========================================================
# Versiones del contenedor
# ==========================================================
TESTKIT_PHP_VERSION=8.4
TESTKIT_NODE_VERSION=20

# ==========================================================
# Query profiling (app-level) — opcional
# ==========================================================
# Si querés medir cuántas queries se ejecutan y contra qué tablas/columnas:
# - set TEST_DB_PROFILE=1
# - en tus tests, usá tk_pdo() (ver test/utils/php/db_profiler.php)
# - luego generá reporte: php testkit/scripts/query_report.php

# DSN (recomendado: apuntar a mysql_test dentro del compose)
TEST_DB_DSN=mysql:host=mysql_test;port=3306;dbname=app_test;charset=utf8mb4
TEST_DB_USER=app
TEST_DB_PASS=app

TEST_DB_PROFILE=0
TEST_DB_PROFILE_LOG=/workspace/testkit/_out/querylog.jsonl
TEST_DB_PROFILE_TOP=20
TEST_DB_PROFILE_SLOW=15

# ==========================================================
# Timing
# ==========================================================
# Muestra el top N tests más lentos por archivo cuando se usa t_run_cli()
TEST_TIME_TOP=10
