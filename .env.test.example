# ==========================================================
# TestKit — env de tests
#
# Ubicación soportada (sin ambigüedades):
# - Preferida: <repo>/test/.env.test
# - Alternativa: <repo>/.env.test
# ==========================================================

# Store estructural: obligatorio y exacto.
# Valores válidos: mysql, pgsql, none
# No se infiere desde DB_DRIVER, TEST_DB_DRIVER, DSN, credenciales ni stack.
TEST_STORE_DRIVER=mysql

# Stack de infraestructura para tests
# Valores válidos actuales: mysql, redis, pg, influx
TESTKIT_STACK=mysql,redis

TK_BACK_DIR=back
TK_PUBLIC_DIR=public_html

APP_ENV=test
APP_DEBUG=1

TEST_JOBS=1
TEST_DB_STRATEGY=shared
TEST_DB_WORKER_SUFFIX_FORMAT=_w%02d
TEST_DB_CLEAN_EACH=0
TEST_DB_CLEAN_ALWAYS=0
TEST_META_FAIL_FAST=0
TEST_CHILD_FAIL_FAST=0
TEST_JS_REQUIRE_NODE=0

# MySQL
TEST_MYSQL_ROOT_PASSWORD=root
TEST_MYSQL_DB=app_test
TEST_MYSQL_USER=app
TEST_MYSQL_PASSWORD=app
TEST_MYSQL_PORT=33070
DB_HOST=mysql_test
DB_PORT=3306
DB_NAME=app_test
DB_USER=app
DB_PASS=app

# PostgreSQL opcional — requiere TEST_STORE_DRIVER=pgsql y TESTKIT_STACK con pg
TEST_PG_DB=app_test
TEST_PG_USER=app
TEST_PG_PASSWORD=app
TEST_PG_PORT=54370
PG_HOST=postgres_test
PG_PORT=5432
PG_DB=app_test
PG_USER=app
PG_PASS=app

# Redis opcional
# REDIS_HOST=redis_test
# REDIS_PORT=6379

# InfluxDB 2.7 opcional
TEST_INFLUX_ORG=testkit
TEST_INFLUX_BUCKET=testkit
TEST_INFLUX_TOKEN=testkit-token
TEST_INFLUX_ADMIN_TOKEN=testkit-admin-token
TEST_INFLUX_PORT=38086

TEST_USE_PUBLIC_LOADER=1
TEST_IMPORT_DEBUG=0

TEST_COVERAGE=0
TEST_COVERAGE_FORMAT=lcov

TESTKIT_PHP_VERSION=8.4
TESTKIT_NODE_VERSION=20

# Query profiling: TEST_DB_DSN es conexión, nunca selector de store.
TEST_DB_DSN=mysql:host=mysql_test;port=3306;dbname=app_test;charset=utf8mb4
TEST_DB_USER=app
TEST_DB_PASS=app
TEST_DB_PROFILE=0
TEST_DB_PROFILE_LOG=/workspace/project/test/querylog.jsonl
TEST_DB_PROFILE_TOP=20
TEST_DB_PROFILE_SLOW=15

TEST_TIME_TOP=10
TEST_METADATA_SCAN_LINES=60
TEST_TAGS_FROM_FILENAME=1
TEST_CRITICAL_TAGS=critical,contract
TEST_PYTHON_BINARY=python3
TEST_COVERAGE_SOURCE_DIRS=back,public_html
TEST_COVERAGE_LOW_THRESHOLD=70
TEST_COVERAGE_CRITICAL_THRESHOLD=85
TEST_SLOW_THRESHOLD_MS=1500
TEST_SLOW_TOP=10
TEST_PERF_MAX_MS=0
TEST_PERF_WARN_MS=0
TEST_FLAKE_WINDOW=10
