# ==========================================================
# TestKit — env de tests
#
# Ubicación soportada (sin ambigüedades):
# - Preferida: <repo>/test/.env.test
# - Alternativa: <repo>/.env.test
#
# 1) Copiar este ejemplo y editar:
#    - cp testkit/.env.test.example <project>/test/.env.test
#
# Nota importante:
# - bin/testkit elige automáticamente el env (test/.env.test primero, luego .env.test root)
# - Docker Compose usa el env elegido vía: docker compose --env-file <env>
# - En contenedor, DB_ENV_PATH apunta al env correcto (/workspace/project/test/.env.test o /workspace/project/.env.test)
# ==========================================================

# ==========================================================
# Store estructural
# ==========================================================
# Obligatorio. Único selector del store principal.
# Valores exactos: mysql, pgsql, none
# No se infiere desde DB_DRIVER, TEST_DB_DRIVER, DSN, credenciales ni stack.
TEST_STORE_DRIVER=mysql

# Política de provisión del store:
# - managed  => testkit crea/valida la base y requiere credenciales admin
# - external => la base ya existe y testkit no exige credenciales admin
TEST_STORE_PROVISION=managed

# ==========================================================
# Stack de infraestructura para tests
# ==========================================================
# Selecciona qué overlays de Compose levantar.
# Valores válidos: mysql, redis, pg, influx
#
# Ejemplos:
#   TESTKIT_STACK=mysql
#   TESTKIT_STACK=mysql,redis
#   TESTKIT_STACK=mysql,pg
#   TESTKIT_STACK=mysql,redis,influx
#
# Compatibilidad:
# - si no lo seteás, el comportamiento por default mantiene el stack histórico:
#   mysql + redis
TESTKIT_STACK=mysql,redis

# ==========================================================
# Paths del proyecto (portabilidad)
# ==========================================================
TK_BACK_DIR=back
TK_PUBLIC_DIR=public_html

# Bootstrap / autoload (configurable por proyecto):
# - Si tu proyecto tiene Composer:
#   TK_BACK_AUTOLOAD=${TK_BACK_DIR}/vendor/autoload.php
# - Si NO tiene Composer o necesitás init extra:
#   TK_BACK_BOOTSTRAP=${TK_BACK_DIR}/bootstrap.php
#
# Para front PHP (si aplica):
#   TK_PUBLIC_AUTOLOAD=${TK_PUBLIC_DIR}/vendor/autoload.php
#   TK_PUBLIC_BOOTSTRAP=${TK_PUBLIC_DIR}/bootstrap.php
#
# Si querés que falta de bootstrap sea FAIL temprano:
# TK_REQUIRE_BOOTSTRAP=1

# JS bootstrap (runner):
#   TK_FRONT_BOOTSTRAP=testkit/front/_support/bootstrap.mjs

# ==========================================================
# Runner
# ==========================================================
APP_ENV=test
APP_DEBUG=1

# ==========================================================
# Flags de ejecución (tests)
# ==========================================================
TEST_JOBS=1

TEST_DB_STRATEGY=shared
TEST_DB_WORKER_SUFFIX_FORMAT=_w%02d

TEST_DB_CLEAN_EACH=0
TEST_DB_CLEAN_ALWAYS=0

TEST_META_FAIL_FAST=0
TEST_CHILD_FAIL_FAST=0

TEST_JS_REQUIRE_NODE=0

# ==========================================================
# MySQL
# ==========================================================
# Requeridos para TEST_STORE_PROVISION=managed.
TEST_MYSQL_ADMIN_USER=root
TEST_MYSQL_ROOT_PASSWORD=root

TEST_MYSQL_DB=app_test
TEST_MYSQL_USER=app
TEST_MYSQL_PASSWORD=app
TEST_MYSQL_PORT=33070

DB_HOST=mysql_test
DB_PORT=3306
DB_NAME=app_test
DB_USER=app
DB_PASS=app

# ==========================================================
# Postgres (opcional — requiere TEST_STORE_DRIVER=pgsql y TESTKIT_STACK con pg)
# ==========================================================
TEST_PG_DB=app_test
TEST_PG_USER=app
TEST_PG_PASSWORD=app
TEST_PG_PORT=54370

PG_HOST=postgres_test
PG_PORT=5432
PG_DB=app_test
PG_USER=app
PG_PASS=app

# ==========================================================
# Redis (opcional — requiere TESTKIT_STACK con redis)
# ==========================================================
# REDIS_HOST=redis_test
# REDIS_PORT=6379

# ==========================================================
# InfluxDB 2.7 (opcional — requiere TESTKIT_STACK con influx)
# ==========================================================
TEST_INFLUX_ORG=testkit
TEST_INFLUX_BUCKET=testkit
TEST_INFLUX_TOKEN=testkit-token
TEST_INFLUX_ADMIN_TOKEN=testkit-admin-token
TEST_INFLUX_PORT=38086

# Dentro del contenedor testkit, el host por default es influx_test:8086.
# Sólo sobrescribí esto si tu proyecto necesita una URL distinta.
# TEST_INFLUX_URL=http://influx_test:8086
# TEST_INFLUX_HOST=influx_test
# TEST_INFLUX_INTERNAL_PORT=8086
# TEST_INFLUX_TIMEOUT_SEC=15
# TEST_INFLUX_PRECISION=ns
# TEST_INFLUX_RUN_TAG_KEY=testkit_run_id
# TEST_INFLUX_INIT_USERNAME=testkit
# TEST_INFLUX_INIT_PASSWORD=testkitpass

# ==========================================================
# JS loader
# ==========================================================
TEST_USE_PUBLIC_LOADER=1
TEST_IMPORT_DEBUG=0

# ==========================================================
# Coverage
# ==========================================================
TEST_COVERAGE=0
TEST_COVERAGE_FORMAT=lcov

# ==========================================================
# Versiones del contenedor
# ==========================================================
TESTKIT_PHP_VERSION=8.4
TESTKIT_NODE_VERSION=24

# ==========================================================
# Query profiling (app-level)
# ==========================================================
# TEST_DB_DSN describe conexión; nunca selecciona TEST_STORE_DRIVER.
TEST_DB_DSN=mysql:host=mysql_test;port=3306;dbname=app_test;charset=utf8mb4
TEST_DB_USER=app
TEST_DB_PASS=app

TEST_DB_PROFILE=0
TEST_DB_PROFILE_LOG=/workspace/project/test/querylog.jsonl
TEST_DB_PROFILE_TOP=20
TEST_DB_PROFILE_SLOW=15

# ==========================================================
# Timing / filtros / coverage diagnostics
# ==========================================================
TEST_TIME_TOP=10
TEST_METADATA_SCAN_LINES=60
TEST_TAGS_FROM_FILENAME=1
TEST_CRITICAL_TAGS=critical,contract
TEST_PYTHON_BINARY=python3
TEST_COVERAGE_SOURCE_DIRS=back,public_html
TEST_COVERAGE_LOW_THRESHOLD=70
TEST_COVERAGE_CRITICAL_THRESHOLD=85
TEST_SLOW_THRESHOLD_MS=1500
TEST_SLOW_TOP=10
TEST_PERF_MAX_MS=0
TEST_PERF_WARN_MS=0
TEST_FLAKE_WINDOW=10
