# ==========================================================
# TestKit — env de tests (vive dentro de test/)
#
# 1) Copiar a: test/.env.test
# 2) Editar variables según el proyecto
#
# Nota importante:
# - Docker Compose usa ESTE archivo vía: docker compose --env-file test/.env.test
# - Los runners leen ESTE archivo vía: DB_ENV_PATH=/app/test/.env.test
# ==========================================================

# --- Runner
APP_ENV=test
APP_DEBUG=1

# ==========================================================
# MySQL (default)
# ==========================================================
TEST_MYSQL_ROOT_PASSWORD=root
TEST_MYSQL_DB=app_test
TEST_MYSQL_USER=app
TEST_MYSQL_PASSWORD=app
TEST_MYSQL_PORT=33070

# Variables que normalmente usa tu app (alinearlas con las anteriores)
DB_DRIVER=mysql
DB_HOST=mysql_test
DB_PORT=3306
DB_NAME=app_test
DB_USER=app
DB_PASS=app

# ==========================================================
# Postgres (opcional — solo si levantás con --pg)
# ==========================================================
TEST_PG_DB=app_test
TEST_PG_USER=app
TEST_PG_PASSWORD=app
TEST_PG_PORT=54370

PG_HOST=postgres_test
PG_PORT=5432
PG_DB=app_test
PG_USER=app
PG_PASS=app

# ==========================================================
# JS loader
# ==========================================================
# Si tus tests de JS importan desde test/front pero el código vive en public_html,
# dejalo en 1 para redirigir imports.
TEST_USE_PUBLIC_LOADER=1
TEST_IMPORT_DEBUG=0

# ==========================================================
# Coverage (los runners lo leen)
# ==========================================================
TEST_COVERAGE=0
TEST_COVERAGE_FORMAT=lcov
# Si querés un directorio único, usá esto (los runners también tienen defaults por suite)
# TEST_COVERAGE_DIR=/app/test/_out/coverage

# ==========================================================
# Versiones del contenedor
# ==========================================================
TESTKIT_PHP_VERSION=8.4
TESTKIT_NODE_VERSION=20

# ==========================================================
# Query profiling (app-level) — opcional
# ==========================================================
# Si querés medir cuántas queries se ejecutan y contra qué tablas/columnas:
# - set TEST_DB_PROFILE=1
# - en tus tests, usá tk_pdo() (ver test/utils/php/db_profiler.php)
# - luego generá reporte: php test/scripts/query_report.php

# DSN (recomendado: apuntar a mysql_test dentro del compose)
TEST_DB_DSN=mysql:host=mysql_test;port=3306;dbname=app_test;charset=utf8mb4
TEST_DB_USER=app
TEST_DB_PASS=app

TEST_DB_PROFILE=0
TEST_DB_PROFILE_LOG=/app/test/_out/querylog.jsonl
TEST_DB_PROFILE_TOP=20
TEST_DB_PROFILE_SLOW=15

# ==========================================================
# Timing
# ==========================================================
# Muestra el top N tests más lentos por archivo cuando se usa t_run_cli()
TEST_TIME_TOP=10
