{
  "schema_version": "mysql-query-gate-v1",
  "gate": {
    "id": "pruebas.sql.ci",
    "description": "SQL gate test fixture",
    "mode": "report",
    "defaults": {
      "minimum_severity": "info",
      "on_incompatible_context": "report",
      "on_insufficient_data": "report",
      "on_invalid_embedded_evidence": "error"
    },
    "stability": {
      "temporal": {
        "required_runs": 3,
        "required_confirmations": 2,
        "minimum_sample_count": 20,
        "maximum_age_hours": 720
      },
      "structural": {
        "required_runs": 1,
        "required_confirmations": 1,
        "minimum_sample_count": 0,
        "maximum_age_hours": 720
      }
    },
    "rules": [
      {
        "id": "block-policy-error",
        "selectors": {
          "category": [
            "policy.violation"
          ],
          "severity": [
            "error"
          ]
        },
        "decision": "block",
        "stability_type": "none"
      },
      {
        "id": "block-plan-regression",
        "selectors": {
          "category": [
            "baseline.plan_regression"
          ]
        },
        "decision": "block",
        "allow_structural_only": true,
        "stability_type": "structural"
      },
      {
        "id": "block-structural-regression",
        "selectors": {
          "category": [
            "baseline.structural_regression"
          ]
        },
        "decision": "block",
        "allow_structural_only": true,
        "stability_type": "structural"
      },
      {
        "id": "block-temporal-regression",
        "selectors": {
          "category": [
            "baseline.temporal_regression"
          ]
        },
        "decision": "block",
        "stability_type": "temporal"
      },
      {
        "id": "block-instrumentation-bypass",
        "selectors": {
          "category": [
            "instrumentation.bypass"
          ]
        },
        "decision": "block",
        "stability_type": "structural"
      },
      {
        "id": "warn-new-query",
        "selectors": {
          "category": [
            "baseline.new_query"
          ]
        },
        "decision": "warn",
        "stability_type": "structural"
      },
      {
        "id": "warn-expired-allowlist",
        "selectors": {
          "category": [
            "allowlist.expired"
          ]
        },
        "decision": "warn",
        "stability_type": "none"
      },
      {
        "id": "observe-removed-query",
        "selectors": {
          "category": [
            "baseline.removed_query"
          ]
        },
        "decision": "observe",
        "stability_type": "structural"
      },
      {
        "id": "warn-insufficient",
        "selectors": {
          "category": [
            "evidence.insufficient"
          ]
        },
        "decision": "warn",
        "stability_type": "none"
      }
    ],
    "outputs": {
      "json": true,
      "junit": true,
      "sarif": true,
      "summary": true,
      "github_annotations": false,
      "github_step_summary": false
    },
    "baseline_approval": {
      "enabled": true,
      "minimum_policy_severity": "error",
      "minimum_sample_count": 20,
      "minimum_successful_runs": 1,
      "require_full_compatibility": true,
      "require_source_commit": true,
      "require_dataset_identity": true,
      "require_environment_identity": true
    }
  }
}
