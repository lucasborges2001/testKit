# Baseline: let Git detect text vs binary, normalize line endings to LF.
* text=auto eol=lf

# Bash entrypoints and scripts run inside Linux containers: LF is required.
bin/testkit text eol=lf
*.sh text eol=lf

# PowerShell wrapper: LF is explicit policy, not an accident of checkout.
# pwsh 7 (the supported target) parses LF scripts without issue.
*.ps1 text eol=lf
*.psm1 text eol=lf

# Everything else that is committed source/config text.
*.php text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
